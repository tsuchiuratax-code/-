/**
 * テンプレート一覧を取得する
 * @returns {Array} テンプレートのキーと概要の配列
 */
function getNewsletterTemplates() {
  return Object.entries(NEWSLETTER_TEMPLATES).map(([key, tmpl]) => ({
    key,
    title:  tmpl.title,
    season: tmpl.season,
    target: tmpl.target,
  }));
}

/**
 * テンプレートを取得する
 * @param {string} key
 * @returns {Object}
 */
function getNewsletterTemplate(key) {
  return NEWSLETTER_TEMPLATES[key] || null;
}

/**
 * 今月のテンプレートを取得する
 * @returns {Object|null}
 */
function getThisMonthTemplate() {
  const month = new Date().getMonth() + 1;
  const key = Object.keys(NEWSLETTER_TEMPLATES).find(k =>
    NEWSLETTER_TEMPLATES[k].season === month + '月'
  );
  return key ? { key, ...NEWSLETTER_TEMPLATES[key] } : null;
}

/**
 * テンプレートの年度を自動置換する
 * @param {string} text
 * @returns {string}
 */
function fillYear(text) {
  const now = new Date();
  const wareki = getWareki(now.getFullYear());
  return text
    .replace(/令和○年/g, `令和${wareki}年`)
    .replace(/R○/g, `R${wareki}`);
}

function getWareki(year) {
  // 令和元年 = 2019
  return year - 2018;
}
